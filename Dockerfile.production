# Production/acquisition release container.
# Every base image is pinned by immutable Docker Official Image index digest.
# Debian package resolution is pinned to one literal snapshot.debian.org state.

FROM golang:1.24-bookworm@sha256:1a6d4452c65dea36aac2e2d606b01b4a029ec90cc1ae53890540ce6173ea77ac AS go-toolchain

FROM python:3.12-bookworm@sha256:581429e3df12d76e6af4be5ab7d0e7fc2013eb57dc23d2de691411c8efdbb970 AS builder

COPY --from=go-toolchain /usr/local/go /usr/local/go
ENV PATH="/usr/local/go/bin:${PATH}"

RUN set -eux; \
    printf '%s\n' \
      "deb [check-valid-until=no] https://snapshot.debian.org/archive/debian/20260901T000000Z/ bookworm main" \
      "deb [check-valid-until=no] https://snapshot.debian.org/archive/debian-security/20260901T000000Z/ bookworm-security main" \
      > /etc/apt/sources.list; \
    rm -f /etc/apt/sources.list.d/*; \
    apt-get -o Acquire::Check-Valid-Until=false update; \
    apt-get -o Acquire::Check-Valid-Until=false install -y --no-install-recommends \
      build-essential \
      ca-certificates \
      patchelf; \
    dpkg-query -W -f='${Package}\t${Version}\n' \
      build-essential ca-certificates patchelf \
      | sort > /tmp/koschei-debian-build-packages.tsv; \
    rm -rf /var/lib/apt/lists/*

COPY production-build-bootstrap.txt /tmp/production-build-bootstrap.txt
COPY production-build-requirements.txt /tmp/production-build-requirements.txt
RUN python -m pip install \
      --no-cache-dir \
      --require-hashes \
      --no-deps \
      --only-binary=:all: \
      -r /tmp/production-build-bootstrap.txt \
    && python -m pip install \
      --no-cache-dir \
      --require-hashes \
      --no-deps \
      --no-build-isolation \
      -r /tmp/production-build-requirements.txt

WORKDIR /src
COPY . .

# The immutable source commit is supplied by the release orchestrator and then
# embedded into the staging manifest. This build never assumes that .git is
# present inside the container context.
ARG RELEASE_GIT_COMMIT_SHA
RUN set -eux; \
    test -n "${RELEASE_GIT_COMMIT_SHA}"; \
    python tools/build_solohost_binary_v1.py --mode onefile --output out/build; \
    BIN="$(find out/build -type f -name ks -perm -111 | head -n1)"; \
    test -n "$BIN"; \
    python tools/smoke_solohost_binary_v1.py "$BIN" --require-native-build --receipt out/smoke.json; \
    VERSION="$("$BIN" version --json | python -c 'import json,sys; print(json.load(sys.stdin)["version"])')"; \
    test -n "$VERSION"; \
    python tools/assemble_solohost_staging_v1.py \
      --binary "$BIN" \
      --output out/release \
      --version "$VERSION" \
      --platform linux-x86_64 \
      --source-commit "${RELEASE_GIT_COMMIT_SHA}" \
      --smoke-receipt out/smoke.json; \
    cp /tmp/koschei-debian-build-packages.tsv out/release/; \
    cp production-container-lock.json out/release/; \
    cp production-build-bootstrap.txt out/release/; \
    cp production-build-requirements.txt out/release/; \
    mkdir -p out/publish; \
    python tools/deterministic_release_zip_v1.py \
      --staging out/release \
      --output "out/publish/koschei-lang-${VERSION}-linux-x86_64.zip"; \
    sha256sum out/publish/koschei-lang-*-linux-x86_64.zip > out/publish/package.sha256

FROM python:3.12-slim-bookworm@sha256:782412e85d0f0984994c290652577d4018aff08145c85b262bb63dc0c7522254 AS runtime
WORKDIR /srv
COPY --from=builder /src/out/publish/ /srv/

EXPOSE 8080
CMD ["sh", "-c", "python -m http.server ${PORT:-8080} --bind 0.0.0.0 --directory /srv"]
