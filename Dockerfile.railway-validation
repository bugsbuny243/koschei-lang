FROM golang:1.24-bookworm AS go
FROM python:3.13-bookworm
COPY --from=go /usr/local/go /usr/local/go
ENV PATH="/usr/local/go/bin:${PATH}"
WORKDIR /app
COPY . .
RUN go version
RUN python -m unittest -v tests.test_production_reference_system_v1
CMD ["python", "-c", "import time; print('production-reference-v1 go+python validation passed'); time.sleep(3600)"]
