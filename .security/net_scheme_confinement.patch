+class NetSchemeConfinementTests(unittest.TestCase):
+    """Ağ yetkisi başka bir yetki alanına köprü kuramaz.
+
+    urllib'in varsayılan opener'ı file/ftp/data handler'ları taşır. Şema
+    kısıtlanmazsa `caps.net.allow("file://localhost/...")` ağ jetonunu yerel
+    dosya okuma aracına çevirir ve manifesto "DİSK: yok" demeye devam eder.
+    Aşağıdaki testler bu köprüyü üç katmanda da kapalı tutar.
+    """
+
+    def test_file_scheme_origin_is_rejected_at_compile_time(self) -> None:
+        program = parse(
+            'fn main(caps: SystemCaps) {\n'
+            '    let n = caps.net.allow("file://localhost/etc/passwd")\n'
+            '}'
+        )
+        with self.assertRaisesRegex(SemanticError, "KS2405"):
+            check(program)
+
+    def test_ftp_scheme_origin_is_rejected_at_compile_time(self) -> None:
+        program = parse(
+            'fn main(caps: SystemCaps) {\n'
+            '    let n = caps.net.allow("ftp://example.com/x")\n'
+            '}'
+        )
+        with self.assertRaisesRegex(SemanticError, "KS2405"):
+            check(program)
+
+    def test_origin_without_scheme_is_rejected(self) -> None:
+        program = parse(
+            'fn main(caps: SystemCaps) {\n'
+            '    let n = caps.net.allow("example.com")\n'
+            '}'
+        )
+        with self.assertRaisesRegex(SemanticError, "KS2405"):
+            check(program)
+
+    def test_http_and_https_origins_remain_allowed(self) -> None:
+        for origin in ("https://api.example.com", "http://localhost:8080"):
+            with self.subTest(origin=origin):
+                program = parse(
+                    'fn main(caps: SystemCaps) {\n'
+                    f'    let n = caps.net.allow("{origin}")\n'
+                    '}'
+                )
+                check(program)
+
+    def test_non_http_scheme_never_yields_an_origin_key(self) -> None:
+        """Dinamik origin'ler derleyiciden kaçar; runtime allowlist son settir."""
+        for url in (
+            "file://localhost/etc/passwd",
+            "ftp://example.com/x",
+            "data://x/y",
+            "gopher://example.com/1",
+        ):
+            with self.subTest(url=url):
+                self.assertIsNone(_origin_key(url))
+
+    def test_opener_carries_no_file_or_ftp_handlers(self) -> None:
+        """build_opener() açıkça handler verilse bile FileHandler ekler.
+
+        Bu test, OpenerDirector'ın elle kurulduğunu ve birinin ileride
+        kolaylık olsun diye build_opener()'a geri dönmediğini garanti eder.
+        """
+        opener = _build_http_only_opener(("https", "api.example.com", 443))
+        names = {type(handler).__name__ for handler in opener.handlers}
+        self.assertNotIn("FileHandler", names)
+        self.assertNotIn("FTPHandler", names)
+        self.assertNotIn("DataHandler", names)
+        self.assertNotIn("UnknownHandler", names)
+        self.assertIn("HTTPSHandler", names)
+
+    def test_net_capability_cannot_read_a_local_file(self) -> None:
+        """Uçtan uca: NetCaps ile yerel dosya okunamaz."""
+        with tempfile.TemporaryDirectory() as directory:
+            secret = pathlib.Path(directory) / "secret.txt"
+            secret.write_text("SIZINTI", encoding="utf-8")
+            url = f"file://localhost{secret}"
+
+            capability = NetCaps(url)
+            result = capability.get(url)
+
+        self.assertIsInstance(result, KsError)
+        self.assertIn("KS3402", str(result.message))
+        self.assertNotIn("SIZINTI", str(result.message))
+
+    def test_dynamic_file_origin_is_blocked_by_the_language_runtime(self) -> None:
+        """Literal olmayan origin semantic katmandan geçse bile dosya okunamaz."""
+        with tempfile.TemporaryDirectory() as directory:
+            secret = pathlib.Path(directory) / "secret.txt"
